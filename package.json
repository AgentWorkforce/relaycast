{
  "name": "relaycast",
  "module": "packages/mcp/src/smithery.ts",
  "packageManager": "npm@10.9.4",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "turbo dev --parallel --filter=@relaycast/server --filter=@relaycast/dashboard",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply relaycast --local",
    "db:migrate:remote": "wrangler d1 migrations apply relaycast --remote",
    "db:execute": "wrangler d1 execute relaycast",
    "e2e": "npx tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.2",
    "turbo": "^2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
