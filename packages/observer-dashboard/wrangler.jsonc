{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relaycast-observer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only through the observer router's service binding
  // (wrangler.observer-router.toml), not on a public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
